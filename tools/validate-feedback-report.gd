extends RefCounted
const Report = preload("res://scripts/feedback_report.gd")

static func validate(game, check: Callable) -> void:
	var folder = "res://artifacts/feedback-qa-"+str(Time.get_ticks_usec())
	DirAccess.make_dir_recursive_absolute(folder)
	var png = folder.path_join("截图.PNG")
	var jpg = folder.path_join("second.jpg")
	var image = Image.create(2400,1600,false,Image.FORMAT_RGB8)
	image.fill(Color(.2,.5,.8))
	image.save_png(png)
	image.resize(32,24)
	image.save_jpg(jpg)
	var original = FileAccess.get_file_as_bytes(png)
	var report = Report.new()
	var archive = folder.path_join("feedback.zip")
	check.call(not report.export_package(archive) and not FileAccess.file_exists(archive),"Blank issue cannot produce a feedback package")
	report.description = " \n\t "
	check.call(not report.validate(),"Whitespace cannot bypass the required issue description")
	report.description = " 林地僵尸过桥时出现卡顿\n第二行：重现步骤 "
	check.call(report.validate() and report.suggestion.is_empty(),"Suggestion and screenshots remain optional")
	check.call(report.add_image(png) and report.attachments[0].width == 1920 and report.attachments[0].height == 1280,"Oversized PNG is resized and accepted with an uppercase extension")
	check.call(report.attachments[0].preview.get_width() <= 160 and FileAccess.get_file_as_bytes(png) == original,"Preview stays small and original screenshot remains byte-identical")
	check.call(report.add_image(jpg) and report.add_image(png) and not report.add_image(jpg) and report.attachments.size() == 3,"Exactly three PNG/JPG attachments are accepted, with a clear fourth-image rejection")
	report.remove_image(1)
	check.call(report.attachments.size() == 2 and report.add_image(jpg),"Removing an attachment frees a slot")
	report.suggestion = "建议减少重复查询。"
	check.call(report.export_package(archive),"A valid Chinese report and screenshots export as a ZIP")
	var reader = ZIPReader.new()
	check.call(reader.open(archive) == OK and reader.get_files().size() == 5,"Feedback ZIP contains text, metadata and three screenshots")
	var document = JSON.parse_string(reader.read_file("report.json").get_string_from_utf8())
	check.call(document.description == report.description.strip_edges() and document.suggestion == report.suggestion and document.screenshots.size() == 3,"Export preserves multiline UTF-8 text and attachment count")
	check.call(not JSON.stringify(document).contains(folder) and not JSON.stringify(document).contains("截图.PNG"),"Metadata omits private source paths and source image filenames")
	check.call(reader.read_file("report.txt").get_string_from_utf8().contains("建议减少重复查询"),"Readable text report includes the optional suggestion")
	var decoded = Image.new()
	check.call(decoded.load_jpg_from_buffer(reader.read_file("screenshots/screenshot_01.jpg")) == OK and decoded.get_width() == 1920,"Archive screenshot is a real decoded JPEG at the bounded size")
	reader.close()
	report.suggestion = "覆盖确认后的新建议"
	check.call(report.export_package(archive) and reader.open(archive) == OK,"Export can replace a user-confirmed destination")
	check.call(JSON.parse_string(reader.read_file("report.json").get_string_from_utf8()).suggestion == report.suggestion,"Replacing an export updates the saved data")
	reader.close()
	var invalid = Report.new()
	check.call(not invalid.add_image(folder.path_join("not-an-image.txt")),"Unsupported file types are rejected before decoding")
	var broken = folder.path_join("broken.png")
	var file = FileAccess.open(broken,FileAccess.WRITE)
	file.store_string("not a png")
	file.close()
	check.call(not invalid.add_image(broken),"Invalid image signatures are rejected without adding an attachment")
	var forged = original.slice(0,33)
	for index in range(16,24): forged[index] = 255
	file = FileAccess.open(broken,FileAccess.WRITE)
	file.store_buffer(forged)
	file.close()
	check.call(not invalid.add_image(broken),"Excessive dimensions are rejected before image allocation")
	var budget = PackedByteArray()
	budget.resize(Report.MAX_TOTAL_BYTES)
	invalid.attachments.append({"bytes":budget})
	check.call(not invalid.add_image(jpg) and invalid.notice.contains("3MB"),"Encoded attachment budget is enforced across the entire report")
	report.description = "x".repeat(8001)
	check.call(not report.validate(),"Unbounded text cannot create an oversized report")
	game.return_home()
	var saved = game.ui.feedback_draft
	game.ui.feedback_draft = Report.new()
	game.ui.show_feedback()
	await game.get_tree().process_frame
	var form = game.ui.menu.find_child("FeedbackForm",true,false)
	check.call(form != null and form.issue is TextEdit and form.solution is TextEdit and not form.image_picker.use_native_dialog and game.get_window().gui_embed_subwindows,"Production feedback form uses native multiline inputs and embedded file pickers")
	form.choose_destination()
	check.call(not form.save_picker.visible and form.status.text.contains("请填写"),"Required validation does not open a save dialog")
	form.issue.text = "菜单返回后保留草稿"
	form.issue.text_changed.emit()
	form.solution.text = "选填建议"
	form.solution.text_changed.emit()
	form.add_images(PackedStringArray([png,jpg]))
	check.call(game.ui.feedback_draft.attachments.size() == 2 and form.previews.get_child_count() == 2,"Actual UI builds previews from the selected images")
	game.ui.show_home()
	game.ui.show_feedback()
	form = game.ui.menu.find_child("FeedbackForm",true,false)
	check.call(form.issue.text == "菜单返回后保留草稿" and form.solution.text == "选填建议" and form.previews.get_child_count() == 2,"Closing and reopening the form preserves text and screenshot draft")
	form.remove_image(0)
	check.call(game.ui.feedback_draft.attachments.size() == 1,"The UI remove action updates the exported draft")
	game.ui.show_home()
	game.ui.feedback_draft = saved
	for filename in DirAccess.get_files_at(folder): DirAccess.remove_absolute(folder.path_join(filename))
	DirAccess.remove_absolute(folder)
